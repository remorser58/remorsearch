  "author_idents": {
    "version": "2026-09-30.3",
    "note": "Id, class and data-* name tokens that mark a person's label (an author, member or profile cell). Matched case-insensitively after splitting on hyphens and underscores, so 'author-name', 'nick_area' and 'data-user' all match. itemprop=\"author\" and rel=\"author\" mark a label too, and so does, inside a label, a link whose target is a member or profile URL (the scrubber's profile-URL patterns, privacy.py). While an element holds one of these markers, the reader drops every piece of text inside it, its own and any child element's, and writes one '[author]' placeholder in its place; the only pieces that stay are text in a time element or an element a keep_in_author_idents token marks, and a text piece that on its own is only a date, a time, a relative time, a number with an optional unit or a rating (extract.py). alt and title attribute text is never read. This holds only while the element stays short: an element marked this way whose text runs past author_label_chars (extract.py) is a wrapper, and its text stays — a nested short label or a member/profile link inside a wrapper still drops — so a post body or a comment is never lost with the name. The element's id/class tokens are still recorded for verdict checks.",
    "tokens": ["author", "writer", "nick", "nickname", "user", "username", "member", "profile", "poster",
               "reviewer"]
  },
  "keep_in_author_idents": {
    "version": "2026-09-30.3",
    "note": "Id and class tokens of an element inside an author label whose text names a date, a time, a count or a rating, never a person. While the reader drops a label's text, text inside a time element or an element carrying one of these tokens (split on hyphens and underscores like author_idents, so 'reg-date' and 'view_count' match) stays. A text piece with no such element keeps the same ground by content alone: extract.py keeps a piece that on its own is only a date, a time, a relative time ('3시간 전', '2 days ago'), a number with an optional unit or count word, or a rating ('4.5', '★★★★☆'); everything else in the label, in any child, is dropped.",
    "tokens": ["date", "time", "regdate", "datetime", "ago", "count", "cnt", "like", "view", "hit",
               "rating", "star", "score"]
  },
  "item_idents": {
    "version": "2026-09-30.2",
    "note": "Id and class tokens that mark one item of a repeated per-person list (comments, replies, reviews), split on hyphens and underscores like author_idents; singular forms only, because an element that also carries a list, wrapper, count or body token (comment_list, comment_count, comment_body) holds a whole list or a part of one item, not the boundary between two people's items. The reader writes a '---' line at the outermost such element outside page chrome, so a page that holds several people's items keeps a visible boundary between them even when an item carries no author label.",
    "tokens": ["comment", "reply", "review", "cmt"]
  },
