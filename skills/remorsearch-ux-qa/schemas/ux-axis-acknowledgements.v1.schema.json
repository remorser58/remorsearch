{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ux-axis-acknowledgements.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "entries"
  ],
  "properties": {
    "schema_version": {
      "const": "ux-axis-acknowledgements.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "axis_id",
          "assignment_id",
          "reason",
          "acknowledged_by",
          "acknowledged_at"
        ],
        "properties": {
          "kind": {
            "enum": [
              "missing",
              "partial",
              "excluded",
              "unattributed_request"
            ]
          },
          "axis_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "assignment_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "reason": {
            "type": "string",
            "minLength": 1
          },
          "acknowledged_by": {
            "enum": [
              "agent",
              "owner"
            ]
          },
          "acknowledged_at": {
            "$ref": "ux-reader-return.v1.schema.json#/$defs/timestamp"
          },
          "request_gap": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "host",
              "charged_documents",
              "logged_documents",
              "unmatched_count"
            ],
            "properties": {
              "host": {
                "type": "string",
                "minLength": 1
              },
              "charged_documents": {
                "type": "integer",
                "minimum": 0
              },
              "logged_documents": {
                "type": "integer",
                "minimum": 0
              },
              "unmatched_count": {
                "type": "integer",
                "minimum": 1
              }
            }
          }
        },
        "oneOf": [
          {
            "properties": {
              "kind": {
                "enum": [
                  "missing",
                  "partial"
                ]
              },
              "axis_id": {
                "type": "string",
                "minLength": 1
              },
              "assignment_id": {
                "type": "string",
                "minLength": 1
              }
            },
            "not": {
              "required": [
                "request_gap"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "excluded"
              },
              "axis_id": {
                "type": "string",
                "minLength": 1
              },
              "assignment_id": {
                "type": "null"
              }
            },
            "not": {
              "required": [
                "request_gap"
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "unattributed_request"
              },
              "axis_id": {
                "type": "null"
              },
              "assignment_id": {
                "type": "null"
              }
            },
            "required": [
              "request_gap"
            ]
          }
        ]
      },
      "uniqueItems": true
    }
  }
}
