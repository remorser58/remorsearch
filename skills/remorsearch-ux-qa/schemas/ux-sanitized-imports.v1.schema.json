{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ux-sanitized-imports.v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "run_id",
    "imports"
  ],
  "properties": {
    "schema_version": {
      "const": "ux-sanitized-imports.v1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "imports": {
      "type": "array",
      "items": {
        "$ref": "ux-reader-return.v1.schema.json#/$defs/sanitizedImport"
      },
      "uniqueItems": true
    }
  }
}
