{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/remorser58/Remorsearch_UX_QA_Skill/schemas/ux-evidence-bundle.v1.schema.json",
  "title": "UX Evidence Bundle v1",
  "type": "object",
  "required": [
    "schema_version",
    "bundle_id",
    "permissions",
    "records"
  ],
  "properties": {
    "schema_version": {
      "const": "ux-evidence-bundle.v1"
    },
    "bundle_id": {
      "type": "string",
      "minLength": 1
    },
    "permissions": {
      "type": "object",
      "required": [
        "requested",
        "granted",
        "blocked"
      ],
      "properties": {
        "requested": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "granted": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capability"
          },
          "uniqueItems": true
        },
        "blocked": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "capability",
              "reason"
            ],
            "properties": {
              "capability": {
                "$ref": "#/$defs/capability"
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "records": {
      "type": "object",
      "required": [
        "sources",
        "evidence",
        "claims",
        "personas",
        "scenarios",
        "runs",
        "observations",
        "findings",
        "proposals",
        "figma"
      ],
      "properties": {
        "sources": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/source"
          }
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/evidence"
          }
        },
        "claims": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/claim"
          }
        },
        "personas": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/persona"
          }
        },
        "scenarios": {
          "$ref": "#/$defs/records"
        },
        "runs": {
          "$ref": "#/$defs/records"
        },
        "observations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/observation"
          }
        },
        "findings": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/finding"
          }
        },
        "proposals": {
          "$ref": "#/$defs/records"
        },
        "figma": {
          "$ref": "#/$defs/records"
        }
      }
    },
    "research": {
      "$ref": "#/$defs/research"
    },
    "minimized_from": {
      "type": "object",
      "required": [
        "bundle_id",
        "bundle_input_sha256",
        "gate_input_sha256",
        "rules_version",
        "sanitizer_version",
        "mode"
      ],
      "additionalProperties": false,
      "properties": {
        "bundle_id": {
          "type": "string",
          "minLength": 1
        },
        "bundle_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "gate_input_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "rules_version": {
          "type": "string",
          "minLength": 1
        },
        "sanitizer_version": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "live",
            "fixture"
          ]
        }
      }
    }
  },
  "$defs": {
    "capability": {
      "enum": [
        "read_only",
        "design_write",
        "test_data_write",
        "code_write"
      ]
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "claim": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/claimKind"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "proposed"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "counter_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "research_support_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "research_context_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "persona_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "subject": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/subject"
        },
        "scope": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/scope"
        },
        "about_current_version": {
          "type": "boolean"
        },
        "stakes": {
          "enum": [
            "normal",
            "high"
          ]
        },
        "scenario_priorities": {
          "type": "array",
          "items": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "audience_values": {
          "type": "array",
          "items": {
            "$ref": "ux-reader-return.v1.schema.json#/$defs/audienceValue"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "counter_search": {
          "anyOf": [
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/counterSearch"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        }
      }
    },
    "researchClaim": {
      "type": "object",
      "required": [
        "id",
        "claim_kind",
        "statement",
        "epistemic_status",
        "verification_status",
        "evidence_ids",
        "observation_ids",
        "counter_evidence_ids",
        "context_evidence_ids",
        "research_support_evidence_ids",
        "research_context_evidence_ids",
        "subject",
        "scope",
        "about_current_version",
        "stakes",
        "scenario_priorities",
        "audience_values",
        "counter_search",
        "research_epistemic_status"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "claim_kind": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/claimKind"
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        },
        "verification_status": {
          "enum": [
            "verified",
            "unverified",
            "proposed"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "observation_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "counter_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "context_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "research_support_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "research_context_evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "persona_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "subject": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/subject"
        },
        "scope": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/scope"
        },
        "about_current_version": {
          "type": "boolean"
        },
        "stakes": {
          "enum": [
            "normal",
            "high"
          ]
        },
        "scenario_priorities": {
          "type": "array",
          "items": {
            "enum": [
              "P0",
              "P1",
              "P2",
              "P3"
            ]
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "audience_values": {
          "type": "array",
          "items": {
            "$ref": "ux-reader-return.v1.schema.json#/$defs/audienceValue"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "counter_search": {
          "anyOf": [
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/counterSearch"
            },
            {
              "type": "null"
            }
          ]
        },
        "research_epistemic_status": {
          "enum": [
            "observed",
            "inferred",
            "unknown"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              },
              "claim_kind": {
                "const": "product_behavior"
              }
            },
            "required": [
              "verification_status",
              "claim_kind"
            ]
          },
          "then": {
            "properties": {
              "observation_ids": {
                "minItems": 1
              },
              "epistemic_status": {
                "const": "observed"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "verification_status": {
                "const": "verified"
              },
              "claim_kind": {
                "not": {
                  "const": "product_behavior"
                }
              }
            },
            "required": [
              "verification_status",
              "claim_kind"
            ]
          },
          "then": {
            "properties": {
              "evidence_ids": {
                "minItems": 1
              },
              "epistemic_status": {
                "const": "observed"
              }
            }
          }
        }
      ]
    },
    "source": {
      "type": "object",
      "required": [
        "id"
      ],
      "additionalProperties": true,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "type": "string",
          "minLength": 1
        },
        "source_ref": {
          "type": "string",
          "minLength": 1
        },
        "access_basis": {
          "type": "string",
          "minLength": 1
        },
        "access_method": {
          "type": "string",
          "minLength": 1
        },
        "public_scope": {
          "type": "string",
          "minLength": 1
        },
        "retention_status": {
          "type": "string",
          "minLength": 1
        },
        "source_type": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/sourceType"
        },
        "source_family": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/sourceFamily"
        },
        "platform_family": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/channelFamily"
        },
        "access": {
          "anyOf": [
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/access"
            },
            {
              "type": "null"
            }
          ]
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/readerProvenance"
            },
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/importProvenance"
            }
          ]
        },
        "flags": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/flags"
        },
        "retention_until": {
          "type": [
            "string",
            "null"
          ]
        },
        "research_tombstone": {
          "$ref": "#/$defs/tombstone"
        }
      },
      "allOf": [
        {
          "if": {
            "required": [
              "research_tombstone"
            ]
          },
          "then": {
            "$ref": "#/$defs/sourceTombstone"
          }
        },
        {
          "if": {
            "anyOf": [
              {
                "required": [
                  "provenance"
                ]
              },
              {
                "required": [
                  "access"
                ]
              }
            ]
          },
          "then": {
            "$ref": "#/$defs/researchSource"
          }
        }
      ]
    },
    "tombstone": {
      "type": "object",
      "required": [
        "reason",
        "removed_at",
        "prior_access_basis"
      ],
      "additionalProperties": false,
      "properties": {
        "reason": {
          "enum": [
            "expired",
            "deleted",
            "withdrawn",
            "policy_revoked"
          ]
        },
        "removed_at": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/timestamp"
        },
        "prior_access_basis": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sourceTombstone": {
      "type": "object",
      "required": [
        "id",
        "channel",
        "source_ref",
        "access_basis",
        "access_method",
        "public_scope",
        "retention_status",
        "research_tombstone"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "channel": {
          "enum": [
            "expired",
            "redacted"
          ]
        },
        "source_ref": {
          "type": "string",
          "pattern": "^(expired|redacted)://[^/]+$"
        },
        "access_basis": {
          "const": "redacted"
        },
        "access_method": {
          "enum": [
            "retention_purge",
            "content_purge"
          ]
        },
        "public_scope": {
          "const": "none"
        },
        "retention_status": {
          "enum": [
            "deleted",
            "withdrawn"
          ]
        },
        "research_tombstone": {
          "$ref": "#/$defs/tombstone"
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "research_tombstone": {
                "properties": {
                  "reason": {
                    "const": "expired"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            "required": [
              "research_tombstone"
            ]
          },
          "then": {
            "properties": {
              "channel": {
                "const": "expired"
              },
              "source_ref": {
                "pattern": "^expired://"
              },
              "access_method": {
                "const": "retention_purge"
              },
              "retention_status": {
                "const": "deleted"
              }
            }
          },
          "else": {
            "properties": {
              "channel": {
                "const": "redacted"
              },
              "source_ref": {
                "pattern": "^redacted://"
              },
              "access_method": {
                "const": "content_purge"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "research_tombstone": {
                "properties": {
                  "reason": {
                    "const": "withdrawn"
                  }
                },
                "required": [
                  "reason"
                ]
              }
            },
            "required": [
              "research_tombstone"
            ]
          },
          "then": {
            "properties": {
              "retention_status": {
                "const": "withdrawn"
              }
            }
          },
          "else": {
            "properties": {
              "retention_status": {
                "const": "deleted"
              }
            }
          }
        }
      ]
    },
    "researchSource": {
      "type": "object",
      "required": [
        "title",
        "item_key",
        "source_type",
        "source_family",
        "platform_family",
        "org",
        "author_key",
        "thread_key",
        "published_at",
        "observed_at",
        "valid_at",
        "version",
        "access_method",
        "access_basis",
        "public_scope",
        "retention_status",
        "retention_until",
        "privacy_class",
        "promo_check",
        "flags",
        "provenance",
        "access",
        "id",
        "channel",
        "source_ref",
        "producer_stake"
      ],
      "additionalProperties": true,
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "item_key": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "source_type": {
          "enum": [
            "product_analytics",
            "survey",
            "interview",
            "usability_test",
            "support_tickets",
            "official_statistics",
            "research_paper",
            "market_report",
            "competitor",
            "official_docs",
            "product_brief",
            "community",
            "app_store_reviews",
            "news",
            "expert_judgment",
            "llm_output",
            "synthetic"
          ]
        },
        "source_family": {
          "enum": [
            "measured",
            "statistical",
            "estimate",
            "intent",
            "voice",
            "secondary",
            "expert_judgment",
            "none"
          ]
        },
        "platform_family": {
          "enum": [
            "app_store_reviews",
            "blog",
            "commerce_reviews",
            "community",
            "competitor",
            "expert_judgment",
            "interview",
            "llm_output",
            "market_report",
            "microblog",
            "news",
            "official_docs",
            "official_statistics",
            "product_analytics",
            "product_brief",
            "qna",
            "research_paper",
            "support_tickets",
            "survey",
            "synthetic",
            "usability_test",
            "video"
          ]
        },
        "org": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "author_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "thread_key": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[0-9a-f]{16}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "published_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "observed_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
        },
        "valid_at": {
          "anyOf": [
            {
              "type": "string",
              "format": "date",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
            },
            {
              "type": "null"
            }
          ]
        },
        "version": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "access_method": {
          "type": "string",
          "minLength": 1
        },
        "access_basis": {
          "enum": [
            "public_anonymous",
            "public_teaser",
            "official_api",
            "team_provided",
            "authorised_member",
            "fixture"
          ]
        },
        "public_scope": {
          "type": "string",
          "minLength": 1
        },
        "retention_status": {
          "enum": [
            "retained",
            "withdrawn",
            "deleted",
            "redacted"
          ]
        },
        "retention_until": {
          "anyOf": [
            {
              "type": "string",
              "format": "date-time",
              "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$"
            },
            {
              "type": "null"
            }
          ]
        },
        "privacy_class": {
          "enum": [
            "ordinary",
            "aggregate",
            "protected_individual"
          ]
        },
        "promo_check": {
          "enum": [
            "text_only",
            "text_and_images"
          ]
        },
        "flags": {
          "$ref": "ux-reader-return.v1.schema.json#/$defs/flags"
        },
        "provenance": {
          "oneOf": [
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/readerProvenance"
            },
            {
              "$ref": "ux-reader-return.v1.schema.json#/$defs/importProvenance"
            }
          ]
        },
        "access": {
          "anyOf": [
            {
